{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "shell_integration": true,
  "pwd": "osc7",
  "cursor_style": "{{ if .Var.vim_cursor }}{{ if eq .Env.POSH_VI_MODE \"viins\" }}steady_bar{{ else if eq .Env.POSH_VI_MODE \"vicmd\" \"visual\" \"viopp\" \"replace\" }}steady_block{{ end }}{{ end }}",
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "palette": {
    "black": "#16161d",
    "red": "#c34043",
    "green": "#76946a",
    "yellow": "#c0a36e",
    "blue": "#7e9cd8",
    "magenta": "#957fb8",
    "cyan": "#6a9589",
    "white": "#c8c093",
    "bright-black": "#727169",
    "bright-red": "#e82424",
    "bright-green": "#98bb6c",
    "bright-yellow": "#e6c384",
    "bright-blue": "#7fb4ca",
    "bright-magenta": "#938aa9",
    "bright-cyan": "#7aa89f",
    "bright-white": "#dcd7ba",
    "git-added": "#76946a",
    "git-removed": "#c34043",
    "git-changed": "#dca561",
    "diag-ok": "#98bb6c",
    "diag-error": "#e82424",
    "diag-warning": "#ff9e3b",
    "diag-info": "#658594",
    "diag-hint": "#6a9589",
    "special": "#938aa9",
    "dim": "#727169",
    "lang": "#7aa89f",
    "tool": "#e6c384",
    "mode-normal": "#7e9cd8",
    "mode-visual": "#957fb8"
  },
  "var": {
    "battery_low": 20,
    "battery_critical": 10,
    "trunc": 30,
    "status_always": true,
    "exec_threshold": 0,
    "session_always": true,
    "show_project": true,
    "vim_cursor": true,
    "vim_show_insert": false,
    "vim_short": false,
    "vim_brackets": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "overflow": "hide",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:diag-warning",
          "template": "󱐋 "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Root }}p:red{{ else }}p:magenta{{ end }}"
          ],
          "template": "{{ if or .Var.session_always .SSHSession .Root }}{{ if .SSHSession }} {{ end }}{{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "foreground_templates": ["{{ if not .Writable }}p:yellow{{ end }}"],
          "template": "{{ if not .Writable }} {{ end }}{{ path .Path .Location }}",
          "options": {
            "folder_separator_icon": "/",
            "home_icon": "~",
            "style": "agnoster_full",
            "mixed_threshold": 5,
            "max_depth": 2
          }
        },
        {
          "type": "project",
          "style": "plain",
          "foreground": "p:dim",
          "template": "{{ if and .Var.show_project .Version }} [{{ .Version }}{{ if .Name }} {{ .Name }}{{ end }}]{{ end }}",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "git",
          "style": "plain",
          "template": "{{ if not (.Segments.Contains \"Jujutsu\") }} <p:special>{{ .HEAD }}</>{{ if or (gt .Ahead 0) (gt .Behind 0) }} <p:bright-cyan>{{ .BranchStatus }}</>{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}{{ if .Working.Changed }}| {{ else }} {{ end }}{{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} <p:blue>*{{ .StashCount }}</>{{ end }}{{ end }}",
          "options": {
            "branch_icon": "󰊢 ",
            "status_formats": {
              "Added": "<p:git-added>+%d</>",
              "Unmerged": "<p:diag-error>X%d</> ",
              "Deleted": "<p:git-removed>-%d</> ",
              "Modified": "<p:git-changed>~%d </> ",
              "Untracked": "<p:diag-warning>?%d</> "
            }
          }
        },
        {
          "type": "jujutsu",
          "style": "plain",
          "template": " <p:special>{{ .ChangeID }}</>{{ if .Working.Changed }} {{ .Working.String }}{{ end }}",
          "options": {
            "status_formats": {
              "Added": "<p:git-added>+%d</>",
              "Deleted": "<p:git-removed>-%d</> ",
              "Modified": "<p:git-changed>~%d </>"
            }
          }
        },
        {
          "type": "mercurial",
          "style": "plain",
          "template": " <p:special>{{ .Branch }}</>{{ if .Working.Changed }} {{ .Working.String }}{{ end }}",
          "options": {
            "status_formats": {
              "Added": "<p:git-added>+%d</>",
              "Deleted": "<p:git-removed>-%d</> ",
              "Modified": "<p:git-changed>~%d </>",
              "Untracked": "<p:diag-warning>?%d</> "
            }
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "java",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "php",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "ruby",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "lua",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "zig",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "deno",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "bun",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "kotlin",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "swift",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "dart",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "elixir",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "haskell",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "ocaml",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "julia",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "r",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }} 󰟔 {{ .Full }}{{ end }}"
        },
        {
          "type": "perl",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "clojure",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "crystal",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }}  {{ .Full }}{{ end }}"
        },
        {
          "type": "nim",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }} 󰆥 {{ .Full }}{{ end }}"
        },
        {
          "type": "fortran",
          "style": "plain",
          "foreground": "p:lang",
          "template": "{{ if not .Error }} 󱈚 {{ .Full }}{{ end }}"
        },
        {
          "type": "docker",
          "style": "plain",
          "foreground": "p:tool",
          "template": " {{ if and .Context (ne .Context \"default\") }} {{ .Context }}{{ end }}"
        },
        {
          "type": "kubectl",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Context }} 󱃾 {{ trunc (int .Var.trunc) (base .Context) }}{{ if and .Namespace (ne .Namespace \"default\") }}/{{ .Namespace }}{{ end }}{{ end }}"
        },
        {
          "type": "aws",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Profile }}  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}{{ end }}",
          "options": {
            "display_default": false
          }
        },
        {
          "type": "az",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Name }}  {{ trunc (int .Var.trunc) .Name }}{{ end }}"
        },
        {
          "type": "gcp",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Project }} 󱇶 {{ trunc (int .Var.trunc) .Project }}{{ end }}"
        },
        {
          "type": "terraform",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .WorkspaceName }} {{ if ne .WorkspaceName \"default\" }} {{ .WorkspaceName }}{{ end }}{{ end }}"
        },
        {
          "type": "helm",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Version }}  {{ .Version }}{{ end }}"
        },
        {
          "type": "pulumi",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Stack }}  {{ .Stack }}{{ end }}",
          "cache": {
            "duration": "30s",
            "strategy": "folder"
          },
          "options": {
            "fetch_stack": true
          }
        },
        {
          "type": "azd",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .DefaultEnvironment }}  {{ .DefaultEnvironment }}{{ end }}"
        },
        {
          "type": "argocd",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Name }}  {{ trunc (int .Var.trunc) .Name }}{{ end }}"
        },
        {
          "type": "firebase",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Project }}  {{ .Project }}{{ end }}"
        },
        {
          "type": "talosctl",
          "style": "plain",
          "foreground": "p:tool",
          "template": "{{ if .Context }} 󱃾 {{ .Context }}{{ end }}"
        },
        {
          "type": "nix-shell",
          "style": "plain",
          "foreground": "p:tool",
          "template": "  {{ .Type }}"
        },
        {
          "type": "battery",
          "style": "plain",
          "foreground": "p:diag-warning",
          "foreground_templates": [
            "{{ if lt .Percentage (int .Var.battery_critical) }}p:diag-error{{ end }}"
          ],
          "template": "{{ if and (not .Error) (eq .State.String \"Discharging\") (lt .Percentage (int .Var.battery_low)) }} 󰂃 {{ .Percentage }}%{{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:dim",
          "template": "{{ if ge .Ms (int .Var.exec_threshold) }} [{{ .FormattedMs }}]{{ end }}",
          "options": {
            "threshold": 500,
            "style": "austin",
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "vimode",
          "style": "plain",
          "foreground_templates": [
            "{{ if eq .Mode \"visual\" }}p:mode-visual{{ else if eq .Mode \"replace\" }}p:red{{ else if eq .Mode \"insert\" }}p:diag-ok{{ else }}p:mode-normal{{ end }}"
          ],
          "template": "{{ if or (eq .Mode \"normal\" \"visual\" \"replace\" \"viopp\") (and .Var.vim_show_insert (eq .Mode \"insert\")) }}{{ $m := .Mode }}{{ if eq $m \"viopp\" }}{{ $m = \"normal\" }}{{ end }}{{ $l := upper $m }}{{ if .Var.vim_short }}{{ $l = upper (substr 0 1 $m) }}{{ end }}{{ if .Var.vim_brackets }}{{ $l = printf \"[%s]\" $l }}{{ end }}{{ $l }} {{ end }}"
        },
        {
          "type": "status",
          "style": "plain",
          "template": "{{ if or .Var.status_always (gt .Code 0) }}({{ .Code }}) {{ end }}",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:diag-error{{ else }}p:diag-ok{{ end }}"
          ],
          "options": {
            "always_enabled": true,
            "status_separator": " | "
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:bright-white",
          "template": ""
        }
      ]
    }
  ],
  "valid_line": {
    "foreground": "p:diag-ok",
    "template": " "
  },
  "error_line": {
    "foreground": "p:diag-error",
    "template": " "
  },
  "secondary_prompt": {
    "foreground": "p:dim",
    "template": "...   "
  }
}
